{
  "schema_version": 1,
  "purpose": "Reviewed, explicit launch profiles. Empty by default: repository metadata is never treated as an executable command.",
  "policy": {
    "shell": false,
    "workspace_root_env": "SYSCENTRE_WORKSPACES",
    "default_workspace_root": "~/.syscentre/workspaces",
    "allowed_executables": [
      "python",
      "python3",
      "node",
      "npm",
      "npx",
      "powershell",
      "pwsh",
      "dotnet"
    ],
    "requirements": [
      "reviewed entrypoint",
      "dependencies installed",
      "isolated workspace",
      "documented port and health check where applicable"
    ]
  },
  "profiles": {
    "localhost-webapp": {
      "enabled": true,
      "adapter_type": "local_process",
      "argv": [
        "node",
        "node_modules/next/dist/bin/next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "4180"
      ],
      "cwd": ".",
      "healthcheck_url": "http://127.0.0.1:4180/",
      "display_url": "http://127.0.0.1:4180/",
      "description": "Verified Next.js starter repository; provision its isolated workspace and dependencies with scripts/Install-SysCentreProject.ps1 before starting.",
      "required_paths": [
        "package.json",
        "package-lock.json",
        "node_modules/next/dist/bin/next"
      ]
    },
    "networklab": {
      "enabled": true,
      "adapter_type": "local_process",
      "argv": [
        "python",
        "-m",
        "app.server"
      ],
      "cwd": ".",
      "healthcheck_url": "http://127.0.0.1:8501/healthz",
      "display_url": "http://127.0.0.1:8501/",
      "description": "Reviewed Python standard-library localhost server. Provision with the SysCentre installer; VM and network-changing actions are not triggered by starting the web process.",
      "required_paths": [
        "app/server.py",
        "web/index.html",
        "web/app.js"
      ]
    }
  }
}
